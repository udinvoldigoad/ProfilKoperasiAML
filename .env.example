NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Di Hostinger pilih runtime Node.js 20.x untuk stabilitas Prisma.
# Hostinger MySQL. Format biasanya:
# mysql://USER:PASSWORD@HOST:3306/NAMA_DATABASE
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/profil_koperasi

# Wajib di produksi untuk menandatangani cookie session lokal.
# Buat string acak panjang, misalnya 32+ karakter.
AUTH_SECRET=

# Optional: domain internal untuk kompatibilitas helper lama.
MEMBER_AUTH_EMAIL_DOMAIN=anggota.agrimulyolestari.local

# Optional: folder storage untuk upload galeri di Hostinger.
# Jika kosong, sistem memakai ./storage/gallery pada runtime Node.js.
GALLERY_UPLOAD_DIR=

# Optional: folder storage untuk upload foto profil anggota di Hostinger.
# Jika kosong, sistem memakai ./storage/profile-photos pada runtime Node.js.
PROFILE_PHOTO_UPLOAD_DIR=

# Optional: folder storage untuk aset gambar bawaan website di Hostinger.
# Jika kosong, sistem memakai ./storage/site-assets pada runtime Node.js.
SITE_ASSET_UPLOAD_DIR=
